PORT=3000
HOST=0.0.0.0

AUTH_DIR=./auth_info
DATA_DIR=./data

DEFAULT_COUNTRY=91
QR_TTL_MS=300000

LOG_LEVEL=info
JSON_LIMIT=5mb

RECONNECT_DELAY_MS=5000
MAX_RECONNECT_DELAY_MS=60000

IDLE_TIMEOUT_MS=300000

AUTO_REPLY_ENABLED=true
AUTO_AI_NEW_USERS=true

# Optional:
# Put numbers here that should receive ONLY AI replies.
# Example:
AI_ONLY_NUMBERS=9876543210

WELCOME_ENABLED=true
WELCOME_TEXT=Hi! 👋 Thanks for messaging Ripun Baruah. I’ll get back to you soon.

BUSY_ENABLED=false
BUSY_TEXT=Hi! I’m currently busy. Please leave your message and I’ll get back to you as soon as possible. 😊

# before_ai = busy message + AI reply
# instead   = busy message only
BUSY_MODE=before_ai

OPENAI_ENABLED=true

# Add your NEW/ROTATED OpenAI keys here.
OPENAI_API_KEY_1=
OPENAI_API_KEY_2=
OPENAI_API_KEY_3=

OPENAI_MODEL=gpt-6-luna
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_MS=30000

AI_MAX_OUTPUT_TOKENS=500
AI_MAX_HISTORY=12

AI_SYSTEM_PROMPT=You are Ripun Baruah replying on WhatsApp. Reply naturally and helpfully like a real person. Keep replies concise unless the user asks for detail. Do not mention that you are an AI unless the user directly asks. Use the same language and tone as the incoming message when practical. Do not invent personal facts about Ripun. If you do not know something, say so briefly.

TYPING_BEFORE_AI=true
TYPING_MIN_MS=400
TYPING_MAX_MS=1400

REPLY_TO_MEDIA=false
