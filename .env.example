
# ── Server ───────────────────────────────────
PORT=3000
HOST=0.0.0.0

# ── Persistent Auth ─────────────────────────
# On Railway with a volume mounted at /data:
AUTH_DIR=/data/auth_info

# On local Ubuntu:
# AUTH_DIR=./auth_info

# ── Security ─────────────────────────────────
# Set a strong random token. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_TOKEN=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET

# ── Logging ─────────────────────────────────
LOG_LEVEL=info
